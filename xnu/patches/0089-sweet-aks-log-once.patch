 #if defined(SWEET)
 #include <IOKit/IOService.h>
@@ -167,6 +168,30 @@ sweet_aks_struct_out_size(IOExternalMethodArguments *args)
 	       (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
 }
 
+/*
+ * Selector logging: every call used to be logged (~1500 lines in a boot,
+ * mostly selector 17 from SpringBoard/coreduetd/contextstored). Log the first
+ * use of each selector (< 64) and the caller; boot-arg sweetakslog=1 restores
+ * one line per call for debugging.
+ */
+static uint64_t sweet_aks_logged;
+
+static bool
+sweet_aks_log_it(uint32_t selector)
+{
+	int loud = 0;
+	if (PE_parse_boot_argn("sweetakslog", &loud, sizeof(loud)) && loud != 0) {
+		return true;
+	}
+	if (selector < 64) {
+		if (sweet_aks_logged & (1ULL << selector)) {
+			return false;
+		}
+		sweet_aks_logged |= 1ULL << selector;
+	}
+	return true;
+}
+
 IOReturn
 AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
     __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
@@ -218,10 +243,12 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	if (sweet_aks_log_it(selector)) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
 #endif /* SWEET */
