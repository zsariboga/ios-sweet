+		char line[200];
+		int n, frames = 0;
 		uint64_t fp;
 
+		if (maxthreads > 0 && tn >= maxthreads) {
+			break;
+		}
 		if (ss == NULL || !is_saved_state64(ss)) {
 			continue;
 		}
 		fp = get_saved_state_fp(ss);
-		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn++,
+		printf("SMP %s t%d tid %llu st 0x%x hint %d wev 0x%llx pc 0x%llx lr 0x%llx sp 0x%llx\n", name, tn,
+		    thread_tid(thread), thread->state, (int)thread->block_hint,
+		    (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event),
 		    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
-		for (int i = 0; i < 16 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		n = snprintf(line, sizeof(line), "SMP %s t%d bt", name, tn);
+		for (int i = 0; i < 24 && fp != 0 && (fp & 7) == 0; i++) {
 			uint64_t frame[2];
 			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
 				break;
 			}
 			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (++frames == 8) {
+				printf("%s\n", line);
+				n = snprintf(line, sizeof(line), "SMP %s t%d bt+", name, tn);
+				frames = 0;
+			}
 			if (frame[0] <= fp) {
 				break;
 			}
 			fp = frame[0];
 		}
-		printf("%s\n", line);
+		if (frames > 0) {
+			printf("%s\n", line);
+		}
+		tn++;
 	}
 	task_unlock(task);
 }
