 void
-sweet_sample_task(const char *name, int pid, task_t task)
+sweet_sample_task(const char *name, int pid, task_t task, int maxthreads)
 {
 	vm_map_t map = get_task_map(task);
 	uint64_t slide = 0;
@@ -1009,33 +1015,48 @@ sweet_sample_task(const char *name, int pid, task_t task)
 		slide = sr->sr_slide;
 		vm_shared_region_deallocate(sr);
 	}
-	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, task->mach_header_vm_address);
+	printf("SMP %s[%d] slide 0x%llx mh 0x%llx threads %d\n", name, pid, slide, task->mach_header_vm_address,
+	    task->thread_count);
 
 	task_lock(task);
 	queue_iterate(&task->threads, thread, thread_t, task_threads) {
 		arm_saved_state_t *ss = find_user_regs(thread);
-		char line[400];
