 OSDefineMetaClassAndStructors(SweetHIDTouch, IOHIDEventService);
 
+/*
+ * Hardware keyboard. backboardd takes any service whose primary usage is
+ * GenericDesktop/Keyboard as an attached hardware keyboard
+ * (BKKeyboardHIDEventProcessor -> GSKeyboardSetHardwareKeyboardAttached)
+ * and UIKit then hides the software keyboard, so the service exists only
+ * while the host has a keyboard attached: sweet_hid_keyboard_attach()
+ * creates and registers it, detach terminates it. CountryCode and
+ * StandardType are what a USB keyboard reports; GraphicsServices picks the
+ * default layout from the country code (USBKeyboardLayouts.plist: 31
+ * Turkish-Q -> Turkish-QWERTY-PC). Keys are HID usages (key positions);
+ * key repeat, modifiers and caps lock are done by the userland keyboard
+ * filter (IOHIDKeyboardFilter). Typed keys are not logged.
+ */
+#define SWEET_KBD_USAGES 256
+class SweetHIDKeyboard : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDKeyboard);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void key(UInt32 page, UInt32 usage, bool down);
+	void releaseKeys();
+	UInt32 fCountry, fStandard;
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_GenericDesktop; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_GD_Keyboard; }
+	virtual OSString *getTransport() APPLE_KEXT_OVERRIDE { return OSString::withCString("USB"); }
+	virtual OSString *getProduct() APPLE_KEXT_OVERRIDE { return OSString::withCString("Sweet Keyboard"); }
+	/* not Apple's vendor ID: no Apple keyboard quirks in the keyboard filter */
+	virtual UInt32 getVendorID() APPLE_KEXT_OVERRIDE { return 0x1209; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 3; }
+private:
+	uint8_t fDown[SWEET_KBD_USAGES / 8];    /* keyboard page keys held */
+};
+OSDefineMetaClassAndStructors(SweetHIDKeyboard, IOHIDEventService);
+
 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
+static SweetHIDKeyboard *gSweetKeyboard;
 
 bool
 SweetHIDButtons::start(IOService *provider)
@@ -553,6 +591,50 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 	collection->release();
 }
 
+bool
+SweetHIDKeyboard::start(IOService *provider)
+{
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOHIDBuiltInKey, kOSBooleanFalse);
+	setProperty(kIOHIDCountryCodeKey, fCountry, 32);
+	setProperty(kIOHIDStandardTypeKey, fStandard, 32);
+	/* the host may send Apple's Globe key (top case page, Fn usage) */
+	setProperty("SupportsGlobeKey", kOSBooleanTrue);
+	registerService();
+	IOLog("SWEET HID: keyboard attached (country %u, type %u)\n", (unsigned)fCountry, (unsigned)fStandard);
+	return true;
+}
+
+void
+SweetHIDKeyboard::key(UInt32 page, UInt32 usage, bool down)
+{
+	if (page == kHIDPage_KeyboardOrKeypad && usage < SWEET_KBD_USAGES) {
+		uint8_t bit = (uint8_t)(1 << (usage & 7));
+		if (((fDown[usage >> 3] & bit) != 0) == down) {
+			return;         /* host repeats: the keyboard filter makes its own */
+		}
+		fDown[usage >> 3] ^= bit;
+	}
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), page, usage, down);
+
+	if (event) {
+		dispatchEvent(event);
+		event->release();
+	}
+}
+
+void
+SweetHIDKeyboard::releaseKeys()
+{
+	for (UInt32 usage = 0; usage < SWEET_KBD_USAGES; usage++) {
+		if (fDown[usage >> 3] & (1 << (usage & 7))) {
+			key(kHIDPage_KeyboardOrKeypad, usage, false);
+		}
+	}
+}
+
 /* key: 0 power (side button), 1 volume up, 2 volume down, 3 home */
 extern "C" void
 sweet_hid_key(int key, int down)
@@ -574,3 +656,58 @@ sweet_hid_touch(int finger, int down, int x, int y)
 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
 }
+
+/*
+ * country: HID country code (0 none, 31 Turkish-Q, 33 US, 35 Turkish-F),
+ * type: 0 ANSI, 1 ISO, 2 JIS. country < 0 detaches the keyboard.
+ * Called from one thread (sweet_sample.c input ring).
+ */
+extern "C" void
+sweet_hid_keyboard_attach(int country, int type)
+{
+	SweetHIDKeyboard *k = gSweetKeyboard;
+	IOService *provider = IOService::getResourceService();
+
+	if (country < 0) {
+		if (k) {
+			gSweetKeyboard = NULL;
+			k->releaseKeys();
+			k->terminate();
+			k->release();
+			IOLog("SWEET HID: keyboard detached\n");
+		}
+		return;
+	}
+	if (k || !provider) {
+		return;
+	}
+	k = OSTypeAlloc(SweetHIDKeyboard);
+	if (!k || !k->init()) {
+		OSSafeReleaseNULL(k);
+		return;
+	}
+	k->fCountry = (UInt32)country;
+	k->fStandard = type > 0 && type <= 2 ? (UInt32)type : 0;
+	if (!k->attach(provider)) {
+		k->release();
+		return;
+	}
+	if (!k->start(provider)) {
+		k->detach(provider);
+		k->release();
+		return;
+	}
+	gSweetKeyboard = k;
+}
+
+/* page 0 = keyboard page; a key down with no keyboard attached attaches one (no country code) */
+extern "C" void
+sweet_hid_keyboard(int page, int usage, int down)
+{
+	if (!gSweetKeyboard && down) {
+		sweet_hid_keyboard_attach(0, 0);
+	}
+	if (gSweetKeyboard && usage >= 0) {
+		gSweetKeyboard->key(page > 0 ? (UInt32)page : kHIDPage_KeyboardOrKeypad, (UInt32)usage, down != 0);
+	}
+}
