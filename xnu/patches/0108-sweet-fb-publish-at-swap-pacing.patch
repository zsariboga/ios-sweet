 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	uint64_t now = mach_absolute_time();
+	/*
+	 * Scanout: publish now instead of at the next vsync tick. The host shows
+	 * frames on its own display clock; latching here only lost frames (a late
+	 * swap followed by an early one inside one tick overwrote the first) and
+	 * added up to a period of latency. The fade while off stays on the timer.
+	 */
 	IOLockLock(fLock);
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
-	fDirty = true;
+	bool direct = fScanout && !fPowerOff;
+	fDirty = !direct;
+	uint64_t vcount = fVsyncCount, ideal = fVsyncNext - fVsyncAbs;
 	IOLockUnlock(fLock);
+	if (direct) {
+		present(rec);
+	}
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
+	if (!fPaceLog) {
+		return;
+	}
+	/* pacing: when in the period the swap came, and how many vsyncs since the last swap */
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now > ideal ? now - ideal : 0, &ns);
+	uint32_t ms = (uint32_t)(ns / 1000000);
+	fPacePhase[ms < 4 ? 0 : ms < 8 ? 1 : ms < 12 ? 2 : ms < 17 ? 3 : 4]++;
+	uint64_t gap = vcount - fPaceLastVsync;
+	if (fPaceSwaps > 0 && gap == 0) {
+		fPaceSame++;            /* two swaps in one period */
+	} else if (fPaceSwaps > 0 && gap >= 2 && gap <= 6) {
+		fPaceMiss += (uint32_t)(gap - 1);  /* vsyncs without a frame inside an animation */
+	}
+	fPaceLastVsync = vcount;
+	fPaceSwaps++;
+	absolutetime_to_nanoseconds(now - fPaceStart, &ns);
+	if (fPaceStart == 0 || ns >= 1000000000ULL) {
+		if (fPaceStart != 0 && fPaceSwaps > 1 && fPaceLines < 5000) {
+			fPaceLines++;
+			IOLog("SWEET FB: pace %u swaps, same-period %u, missed vsyncs %u, swap after vsync <4ms %u <8 %u <12 %u <17 %u later %u\n",
+			    fPaceSwaps, fPaceSame, fPaceMiss, fPacePhase[0], fPacePhase[1], fPacePhase[2], fPacePhase[3], fPacePhase[4]);
+		}
+		fPaceStart = now;
+		fPaceSwaps = fPaceSame = fPaceMiss = 0;
+		bzero(fPacePhase, sizeof(fPacePhase));
+	}
 }
 
