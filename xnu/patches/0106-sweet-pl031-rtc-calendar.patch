 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
 
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * Wall clock: QEMU's virt board has a PL031 RTC (RTCDR = seconds since the
+ * epoch, UTC by default). The phone's RTC lives in the PMIC, which SWEET has
+ * no driver for, so the calendar started at 1970 (lock screen: "Wednesday,
+ * December 31").
+ */
+#define SWEET_PL031_PA   0x09010000ULL
+#define SWEET_PL031_SIZE 0x1000
+
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
 
@@ -18,6 +29,7 @@ public:
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
 };
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
@@ -30,10 +42,38 @@ SweetPlatformExpert::start(IOService *provider)
 		return false;
 	}
 	registerService();
+	/*
+	 * IOKitInitializeTime waits up to 30 s for an "IORTC" resource before
+	 * reading the calendar; nothing else publishes one here.
+	 */
+	publishResource("IORTC", this);
 	IOLog("SWEET: platform expert registered\n");
 	return true;
 }
 
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	static volatile uint32_t *rtc;
+	static bool absent;
+
+	if (absent) {
+		return 0;
+	}
+	if (rtc == NULL) {
+		rtc = (volatile uint32_t *)ml_io_map(SWEET_PL031_PA, SWEET_PL031_SIZE);
+		/* PrimeCell peripheral ID 0x00041031 */
+		if (rtc == NULL || (rtc[0xFE0 / 4] & 0xff) != 0x31 || (rtc[0xFE4 / 4] & 0xff) != 0x10) {
+			IOLog("SWEET: no PL031 RTC at 0x%llx\n", SWEET_PL031_PA);
+			absent = true;
+			return 0;
+		}
+	}
+	long secs = (long)rtc[0];
+	IOLog("SWEET: PL031 RTC time %ld\n", secs);
+	return secs;
+}
