+/*
+ * Selector 6 (IOSurfaceWrapClientImage, patch 0100): a surface over memory the
+ * caller already owns (CoreAnimation's decoded images). Struct in, 32 bytes:
+ * +0 address, +8 width, +0xc height, +0x10 pixel format, +0x14 bytes per
+ * element (computed by the framework), +0x18 bytes per row, +0x1c (unused
+ * here). The pages are wired for the life of the surface so the SweetGL host
+ * can read them from guest RAM. Answering this selector with an empty lock
+ * result (as before) gave CoreAnimation id-0 surfaces with no pixels.
+ */
+static uint32_t sweet_surface_wraps_logged;
+
+IOReturn
+IOSurfaceRootUserClient::wrapClientImage(IOExternalMethodArguments *args)
+{
+	uint8_t in[32];
+	uint64_t addr, len;
+	uint32_t w, h, fmt, bpe, a3, a4, bpr;
+	IOReturn ret;
+
+	if (args->structureInput == NULL || args->structureInputSize < sizeof(in)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(in, args->structureInput, sizeof(in));
+	memcpy(&addr, in, 8);
+	memcpy(&w, in + 8, 4);
+	memcpy(&h, in + 0xc, 4);
+	memcpy(&fmt, in + 0x10, 4);
+	memcpy(&bpe, in + 0x14, 4);
+	memcpy(&a3, in + 0x18, 4);
+	memcpy(&a4, in + 0x1c, 4);
+	bpr = a3 >= (uint64_t)w * bpe ? a3 : w * bpe;
+	len = (uint64_t)bpr * h;
+	if (sweet_surface_wraps_logged < 48) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		sweet_surface_wraps_logged++;
+		IOLog("SWEET SURF: %s wrap 0x%llx %ux%u fmt 0x%x bpe %u a3 %u a4 %u\n", name, addr, w, h, fmt, bpe, a3, a4);
+	}
+	if (addr == 0 || w == 0 || h == 0 || bpe == 0 || w > SWEET_SURFACE_MAX_DIM || h > SWEET_SURFACE_MAX_DIM ||
+	    len > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnBadArgument;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return kIOReturnNoMemory;
+	}
+	s->width = w;
+	s->height = h;
+	s->bytesPerRow = bpr;
+	s->bytesPerElement = (uint16_t)bpe;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = fmt;
+	s->allocSize = (uint32_t)len;
+	s->offset = 0;
+	s->mapCache = kIOMapDefaultCache;
+	s->memory = IOMemoryDescriptor::withAddressRange(addr, len, kIODirectionInOut, fTask);
+	ret = kIOReturnVMError;
+	if (s->memory != NULL && s->memory->prepare() == kIOReturnSuccess) {     /* completed by free() */
+		s->clientWired = true;
+		ret = sweet_surface_publish(s) ? kIOReturnSuccess : kIOReturnNoResources;
+	}
+	if (ret != kIOReturnSuccess) {
+		IOLog("SWEET SURF: wrap 0x%llx %ux%u failed 0x%x\n", addr, w, h, ret);
+		s->release();
+		return ret;
+	}
+	ret = returnSurface(s, args);   /* takes the creator's user count */
+	s->release();
+	return ret;
+}
