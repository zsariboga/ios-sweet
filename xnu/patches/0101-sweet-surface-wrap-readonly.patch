diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 49d288b..e20073f 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -102,7 +102,7 @@ SweetSurface::kernelAddress()
 	}
 	IOLockLock(sweet_surface_lock);
 	if (kernelMap == NULL && memory != NULL) {
-		kernelMap = memory->map(kIOMapWriteCombineCache);
+		kernelMap = memory->map(kIOMapWriteCombineCache | (clientWired ? kIOMapReadOnly : 0));
 	}
 	IOLockUnlock(sweet_surface_lock);
 	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;
@@ -532,7 +532,9 @@ IOSurfaceRootUserClient::addRef(SweetSurface *s, SweetSurfaceRef **refOut, bool
 	s->retain();
 	ref->surface = s;
 	ref->count = 1;
-	ref->data = s->memory->createMappingInTask(fTask, 0, kIOMapAnywhere | s->mapCache);
+	/* wrapped client images may be read-only pages (patch 0101): map them read-only */
+	ref->data = s->memory->createMappingInTask(fTask, 0, kIOMapAnywhere | s->mapCache |
+	    (s->clientWired ? kIOMapReadOnly : 0));
 	ref->state = s->state->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapReadOnly);
 	if (ref->data == NULL || ref->state == NULL) {
 		ref->release();
@@ -763,6 +765,13 @@ IOSurfaceRootUserClient::wrapClientImage(IOExternalMethodArguments *args)
 	memcpy(&a4, in + 0x1c, 4);
 	bpr = a3 >= (uint64_t)w * bpe ? a3 : w * bpe;
 	len = (uint64_t)bpr * h;
+	/*
+	 * a4 = the image's real byte length (bpr * (h - 1) + w * bpe for sub-images of
+	 * an atlas): wiring bpr * h can run past the end of the caller's allocation.
+	 */
+	if (a4 != 0 && a4 < len && a4 >= (uint64_t)bpr * (h - 1) + (uint64_t)w * bpe) {
+		len = a4;
+	}
 	if (sweet_surface_wraps_logged < 48) {
 		char name[32];
 		proc_selfname(name, sizeof(name));
@@ -786,14 +795,27 @@ IOSurfaceRootUserClient::wrapClientImage(IOExternalMethodArguments *args)
 	s->allocSize = (uint32_t)len;
 	s->offset = 0;
 	s->mapCache = kIOMapDefaultCache;
-	s->memory = IOMemoryDescriptor::withAddressRange(addr, len, kIODirectionInOut, fTask);
+	/*
+	 * kIODirectionOut (memory is only read): decoded images are often read-only or
+	 * copy-on-write (mach OOL from the app); wiring them for write failed with
+	 * kIOReturnVMError and CoreAnimation fell back to empty surfaces (no icons).
+	 */
+	s->memory = IOMemoryDescriptor::withAddressRange(addr, len, kIODirectionOut, fTask);
 	ret = kIOReturnVMError;
-	if (s->memory != NULL && s->memory->prepare() == kIOReturnSuccess) {     /* completed by free() */
+	IOReturn pr = s->memory != NULL ? s->memory->prepare() : kIOReturnNoMemory;
+	if (pr != kIOReturnSuccess && sweet_surface_wraps_logged < 96) {
+		sweet_surface_wraps_logged++;
+		IOLog("SWEET SURF: wrap 0x%llx len %llu prepare 0x%x\n", addr, len, pr);
+	}
+	if (pr == kIOReturnSuccess) {     /* completed by free() */
 		s->clientWired = true;
 		ret = sweet_surface_publish(s) ? kIOReturnSuccess : kIOReturnNoResources;
 	}
 	if (ret != kIOReturnSuccess) {
-		IOLog("SWEET SURF: wrap 0x%llx %ux%u failed 0x%x\n", addr, w, h, ret);
+		if (sweet_surface_wraps_logged < 96) {
+			sweet_surface_wraps_logged++;
+			IOLog("SWEET SURF: wrap 0x%llx %ux%u failed 0x%x\n", addr, w, h, ret);
+		}
 		s->release();
 		return ret;
 	}
