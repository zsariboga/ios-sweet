+/*
+ * Direct scanout for a host viewer (QEMU, boot-arg sweetfb_scanout=1): instead
+ * of copying the swapped surface into the panel memory, the guest-physical
+ * segments of the single full-screen layer are published here and the host
+ * (iOS16Viewer, sweetmon) reads the pixels straight from guest RAM. Saves the
+ * ~11 MB CPU copy per frame and shows every frame instead of sweetfb_hz.
+ * seq is odd while the record is written (seqlock). valid = 0: read the panel
+ * (several layers, display off, or no usable surface).
+ * Pixel (x, y) of the panel region at (dx, dy) of size w x h is surface byte
+ * offset + (sy + y) * bpr + (sx + x) * 4, looked up in the segment list.
+ */
+#define SWEET_SCANOUT_MAGIC 0x43535753  /* "SWSC" */
+#define SWEET_SCANOUT_SEGS  2048
+struct sweet_scanout_seg {
+	uint64_t pa;
+	uint64_t len;
+};
+struct sweet_scanout_rec {
+	volatile uint32_t magic;
+	volatile uint32_t seq;
+	uint32_t valid;
+	uint32_t surface;
+	uint32_t bpr, sx, sy, w, h, dx, dy;
+	uint32_t nseg;
+	uint64_t offset;
+	struct sweet_scanout_seg seg[SWEET_SCANOUT_SEGS];
+};
+extern "C" {
+/* Unmangled symbol _sweet_scanout: the host finds it in the kernel's symbol table. */
+struct sweet_scanout_rec sweet_scanout;
+}
+
+static void
+sweet_scanout_begin(void)
+{
+	sweet_scanout.magic = SWEET_SCANOUT_MAGIC;
+	sweet_scanout.seq++;
+	__builtin_arm_dmb(0xb);         /* ish */
+}
+
+static void
+sweet_scanout_end(void)
+{
+	__builtin_arm_dmb(0xb);
+	sweet_scanout.seq++;
+}
+
+static void
+sweet_scanout_invalidate(void)
+{
+	if (sweet_scanout.valid) {
+		sweet_scanout_begin();
+		sweet_scanout.valid = 0;
+		sweet_scanout_end();
+	}
+}
