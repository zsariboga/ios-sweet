+class SweetAccelUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAccelUserClient);
+
+	IOBufferMemoryDescriptor *fRing;
+	int fSlot;
+
+	IOReturn describeSurface(IOExternalMethodArguments *args);
