+/*
+ * SweetGL command rings (patch 0095). A GL client (the SweetGL engine,
+ * GLEngine.bundle/SweetGL) opens this service with type 'SGLR' and maps a
+ * physically contiguous ring with IOConnectMapMemory64(type 0). It writes
+ * GL commands there; the host viewer finds the rings through the
+ * sweet_gl table (kernel symbol _sweet_gl), reads them straight from guest
+ * RAM and executes them on the host GPU. Selector 0 describes an IOSurface
+ * (geometry and physical segments) so the host can read its pixels.
+ */
+#define SWEET_GL_TYPE           0x53474c52u     /* 'SGLR' */
+#define SWEET_GL_TABLE_MAGIC    0x54474c53u     /* 'SGLT' */
+#define SWEET_GL_RING_MAGIC     0x51474c53u     /* 'SGLQ' */
+#define SWEET_GL_RINGS          8
+#define SWEET_GL_RING_SIZE      (32u << 20)
+#define SWEET_GL_DESC_HDR       48
+#define SWEET_GL_DESC_MAX       65536
+
+struct sweet_gl_ring_rec {
+	uint64_t pa;            /* ring physical address, 0 = slot free */
+	uint64_t size;
+	uint32_t pid;
+	uint32_t seq;           /* bumped on every (re)use of the slot */
+};
+
+extern "C" {
+struct sweet_gl_table {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t nrings;
+	uint32_t pad;
+	struct sweet_gl_ring_rec ring[SWEET_GL_RINGS];
+};
+struct sweet_gl_table sweet_gl;
+}
+
+static IOLock *sweet_gl_lock;
+
+static void
+sweet_gl_release_slot(int slot)
+{
+	IOLockLock(sweet_gl_lock);
+	sweet_gl.ring[slot].pa = 0;
+	sweet_gl.ring[slot].seq++;
+	IOLockUnlock(sweet_gl_lock);
+}
 
 #define SWEET_ACCEL_LOG_MAX 400
 #define SWEET_ACCEL_GL_LOG_MAX 20000
