+
+OSDefineMetaClassAndStructors(SweetAccelUserClient, IOUserClient);
+
+bool
+SweetAccelUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	uint32_t *hdr;
+
+	fSlot = -1;
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fRing = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryKernelUserShared,
+	    SWEET_GL_RING_SIZE, 0x0000fffffffff000ULL);
+	if (fRing == NULL) {
+		IOLog("SWEET GL: no contiguous %u MB ring\n", SWEET_GL_RING_SIZE >> 20);
+		return false;
+	}
+	bzero(fRing->getBytesNoCopy(), page_size);
+	hdr = (uint32_t *)fRing->getBytesNoCopy();
+	hdr[0] = SWEET_GL_RING_MAGIC;
+	hdr[1] = 1;                                     /* version */
+	*(uint64_t *)(hdr + 2) = SWEET_GL_RING_SIZE;
+
+	IOLockLock(sweet_gl_lock);
+	for (int i = 0; i < SWEET_GL_RINGS; i++) {
+		if (sweet_gl.ring[i].pa == 0) {
+			fSlot = i;
+			sweet_gl.ring[i].size = SWEET_GL_RING_SIZE;
+			sweet_gl.ring[i].pid = (uint32_t)proc_selfpid();
+			sweet_gl.ring[i].seq++;
+			__builtin_arm_dmb(0xb);
+			sweet_gl.ring[i].pa = fRing->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+			if (i >= (int)sweet_gl.nrings) {
+				sweet_gl.nrings = i + 1;
+			}
+			break;
+		}
+	}
+	IOLockUnlock(sweet_gl_lock);
+	if (fSlot < 0) {
+		IOLog("SWEET GL: all %d rings in use\n", SWEET_GL_RINGS);
+		return false;
+	}
+	IOLog("SWEET GL: ring %d pid %u pa 0x%llx\n", fSlot, sweet_gl.ring[fSlot].pid,
+	    sweet_gl.ring[fSlot].pa);
+	return true;
+}
+
+IOReturn
+SweetAccelUserClient::clientClose(void)
+{
+	if (fSlot >= 0) {
+		sweet_gl_release_slot(fSlot);
+		IOLog("SWEET GL: ring %d closed\n", fSlot);
+		fSlot = -1;
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetAccelUserClient::free()
+{
+	if (fSlot >= 0) {
+		sweet_gl_release_slot(fSlot);
+		fSlot = -1;
+	}
+	OSSafeReleaseNULL(fRing);
+	IOUserClient::free();
+}
+
+IOReturn
+SweetAccelUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	if (type != 0 || fRing == NULL) {
+		return kIOReturnBadArgument;
+	}
+	fRing->retain();
+	*memory = fRing;
+	*options = 0;
+	return kIOReturnSuccess;
+}
+
+/*
+ * Selector 0: scalar in [surface id] -> struct out: 12 u32 (id, width, height,
+ * bytesPerRow, offset, pixelFormat, allocSize, nseg, planeCount,
+ * bytesPerElement, seed, 0) then nseg (pa, len) u64 pairs covering the
+ * surface memory from offset 0 (contiguous pages merged).
+ */
+IOReturn
+SweetAccelUserClient::describeSurface(IOExternalMethodArguments *args)
+{
+	SweetSurface *s;
+	uint8_t *buf;
+	uint32_t *h;
+	uint64_t *seg;
+	uint32_t n = 0, maxseg, len;
+	IOByteCount off = 0, size;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	s = sweet_surface_copy((uint32_t)args->scalarInput[0]);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	buf = (uint8_t *)IOMallocZeroData(SWEET_GL_DESC_MAX);
+	if (buf == NULL) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	h = (uint32_t *)buf;
+	seg = (uint64_t *)(buf + SWEET_GL_DESC_HDR);
+	maxseg = (SWEET_GL_DESC_MAX - SWEET_GL_DESC_HDR) / 16;
+	size = s->memory->getLength();
+	while (off < size) {
+		IOByteCount slen = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &slen, kIOMemoryMapperNone);
+		if (pa == 0 || slen == 0) {
+			ret = kIOReturnVMError;
+			break;
+		}
+		if (slen > size - off) {
+			slen = size - off;
+		}
+		if (n > 0 && seg[2 * (n - 1)] + seg[2 * (n - 1) + 1] == pa) {
+			seg[2 * (n - 1) + 1] += slen;
+		} else if (n < maxseg) {
+			seg[2 * n] = pa;
+			seg[2 * n + 1] = slen;
+			n++;
+		} else {
+			ret = kIOReturnNoSpace;
+			break;
+		}
+		off += slen;
+	}
+	h[0] = s->id;
+	h[1] = s->width;
+	h[2] = s->height;
+	h[3] = s->bytesPerRow;
+	h[4] = s->offset;
+	h[5] = s->pixelFormat;
+	h[6] = s->allocSize;
+	h[7] = n;
+	h[8] = s->planeCount;
+	h[9] = s->bytesPerElement;
+	if (s->state != NULL) {         /* seed: bumped on every unlock (content changed) */
+		h[10] = *(volatile uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + 0xc);
+	}
+	s->release();
+	len = SWEET_GL_DESC_HDR + n * 16;
+	if (ret == kIOReturnSuccess) {
+		if (args->structureOutputDescriptor != NULL) {
+			if (len > args->structureOutputDescriptor->getLength()) {
+				ret = kIOReturnNoSpace;
+			} else {
+				args->structureOutputDescriptor->writeBytes(0, buf, len);
+				args->structureOutputDescriptorSize = len;
+			}
+		} else if (args->structureOutput != NULL && len <= args->structureOutputSize) {
+			memcpy(args->structureOutput, buf, len);
+			args->structureOutputSize = len;
+		} else {
+			ret = kIOReturnNoSpace;
+		}
+	}
+	IOFreeData(buf, SWEET_GL_DESC_MAX);
+	return ret;
+}
+
+IOReturn
+SweetAccelUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	switch (selector) {
+	case 0:
+		return describeSurface(args);
+	default:
+		return kIOReturnUnsupported;
+	}
+}
